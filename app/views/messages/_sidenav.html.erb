<% if chats.any? %>
  <ul class="list-unstyled">
    <li>
      <%= link_to "#", class: "nav-link", data: { action: "click->toggle#call" } do %>
        <i class="fa-solid fa-bars"></i>
      <% end %>
    </li>
    <li>
      <div id="new-chat">
        <%= button_to medication_chats_path(@medication), class: "new-chat-btn" do %>
          <i class="fa-regular fa-pen-to-square"></i>
          New Chat
        <% end %>
      </div>
    </li>

   <% chats.each do |chat| %>
    <li class="mb-2" id="<%= dom_id(chat) %>">
      <div data-controller="toggle">
        <%= link_to chat_path(chat), class: "chat-item chat-link" do %>
            <div class="chat-title-card" id="<%= dom_id(chat, :title) %>">
              <span class="title"><%= chat.title %></span>
              <i class="fa-solid fa-ellipsis icon" data-action="click->toggle#icon"></i>
            </div>
        <% end %>

          <div class="delete-btn-row">
            <%= link_to chat_path(chat), data: { turbo_method: :delete,  toggle_target: "display" }, class:"delete-btn d-none" do %>
            <i class="fa-solid fa-trash-can"></i>
            Delete
            <% end %>
          </div>
        </div>

      </li>
    <% end %>


  </ul>
<% else %>
  <p>There are no chats yet.</p>
<% end %>
