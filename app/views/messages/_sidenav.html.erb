<% if chats.any? %>
  <ul class="list-unstyled">
    <li>
      <%= link_to "#", class: "close-btn", data: { action: "click->chatbot#closesideNav" } do %>
        <i class="fa-solid fa-bars"></i>
      <% end %>
    </li>
    <li>
      <div id="new-chat">
        <%= button_to medication_chats_path(@medication), class: "new-chat-btn" do %>
          <i class="fa-regular fa-pen-to-square"></i>
          New Chat
        <% end %>
      </div>
    </li>

    <% chats.each do |chat| %>
      <li class="mb-2" id="<%= dom_id(chat) %>">
        <div data-controller="chatbot">
          <%= link_to chat_path(chat), class: "chat-item chat-link #{"active" if defined?(@chat) && @chat == chat}" do %>
            <div class="chat-title-card">
              <span class="title" id="<%= dom_id(chat, :title) %>"><%= chat.title %></span>
              <i class="fa-solid fa-ellipsis icon" data-action="click->chatbot#icon"></i>
            </div>
          <% end %>

          <div class="delete-btn-row">
            <%= link_to chat_path(chat), data: { turbo_method: :delete, chatbot_target: "deleteButton" }, class: "delete-btn d-none" do %>
              <i class="fa-solid fa-trash-can"></i>
              Delete
            <% end %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>There are no chats yet.</p>
<% end %>
