<div class="col-12 col-md-4">
  <div class="followed-user-card app-card mx-auto position-relative h-100">
    <div class="followed-user-card__delete position-absolute">
      <%= button_to follow_path(followed_user), method: :delete, class: "btn btn-link p-0 border-0", form: { data: { turbo_confirm: "Unfollow #{followed_user.email}?" } } do %>
        <i class="bi bi-trash icon-muted icon-danger-hover"></i>
      <% end %>
    </div>

    <div class="d-flex align-items-center gap-3 mb-3">
      <%= render "shared/user_avatar", user: followed_user, size: 56 %>
      <div>
        <p class="followed-user-card__name mb-0"><%= followed_user.full_name %></p>
        <p class="followed-user-card__email text-muted mb-0"><%= followed_user.email %></p>
      </div>
    </div>

    <p class="followed-user-card__schedule-label section-header mb-2">Today's schedule</p>

    <% medications = followed_user.medications %>
    <% if medications.empty? %>
      <p class="followed-user-card__empty text-muted fst-italic mb-0">No medications scheduled today</p>
    <% else %>
      <ul class="list-unstyled mb-2">
        <% medications.first(2).each do |medication| %>
          <li class="followed-user-card__med-row d-flex align-items-center gap-2 mb-2">
            <span class="time text-primary"><%= medication.reminder_time %></span>
            <span class="name"><%= medication.name %></span>
            <span class="status-dot rounded-circle ms-auto flex-shrink-0 <%= medication.taken_today? ? "status-dot--taken" : "status-dot--pending" %>"></span>
          </li>
        <% end %>
      </ul>

      <% if medications.size > 2 %>
        <button type="button" class="followed-user-card__see-all-btn btn btn-outline-primary w-100"
                data-bs-toggle="collapse" data-bs-target="#all-meds-<%= followed_user.id %>">
          See all medications &rarr;
        </button>

        <div class="collapse mt-3" id="all-meds-<%= followed_user.id %>">
          <ul class="list-unstyled mb-0 text-start">
            <% medications.each do |medication| %>
              <li class="followed-user-card__all-med-row d-flex align-items-center gap-2 mb-2">
                <span class="time text-primary"><%= medication.reminder_time %></span>
                <span class="name"><%= medication.name %></span>
                <span class="dosage text-muted"><%= medication.dosage %></span>
                <span class="ms-auto small <%= medication.taken_today? ? "text-success" : "text-muted" %>">
                  <%= medication.taken_today? ? "Taken" : "Pending" %>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
