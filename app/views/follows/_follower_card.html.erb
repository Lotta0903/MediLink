<div class="follower-card app-card app-card position-relative">
  <div class="d-flex align-items-center gap-3 mb-3">
    <%= render "shared/user_avatar", user: follower, size: 56 %>
    <div>
      <p class="follower-card__name mb-0"><%= follower.full_name %></p>
      <p class="follower-card__email text-muted mb-0"><%= follower.email %></p>
    </div>
  </div>
</div>
