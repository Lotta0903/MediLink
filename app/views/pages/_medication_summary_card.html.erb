<%
  if medication.taken_today?
    strip_bg    = "#10B981"
    strip_color = "#FFFFFF"
    strip_text  = "✓ TAKEN AT #{medication.last_taken_time}"
  else
    reminder = Time.zone.parse(medication.reminder_time) rescue nil
    now = Time.current

    if reminder.nil? || reminder <= now
      strip_bg    = "#FFE4E6"
      strip_color = "#FB7185"
      strip_text  = "OVERDUE"
    else
      diff_minutes = ((reminder - now) / 60).round
      hours = diff_minutes / 60
      minutes = diff_minutes % 60
      strip_bg    = "#CFFAFE"
      strip_color = "#0891B2"
      strip_text  = "IN #{hours}H #{minutes}M"
    end
  end
%>

<div class="medication-card-horizontal flex-shrink-0">

  <div class="medication-card-content-horizontal text-center flex-grow-1 d-flex flex-column align-items-center justify-content-center">
    <p class="medication-time-horizontal text-primary mb-0"><%= medication.reminder_time %></p>

    <div class="medication-icon-row-horizontal d-flex align-items-center justify-content-center">
      <span class="medication-icon">💊</span>
      <p class="medication-name mb-0"><%= medication.name %></p>
    </div>

    <p class="medication-dosage mb-0"><%= medication.dosage %></p>
    <p class="medication-frequency text-muted mb-0"><%= medication.frequency %></p>
  </div>

  <div class="medication-strip-horizontal text-center" style="background-color: <%= strip_bg %>;">
    <span class="medication-strip-text" style="color: <%= strip_color %>;"><%= strip_text %></span>
  </div>

</div>
