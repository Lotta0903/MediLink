<div class="edit-profile-container container">
  <%= link_to "← Back to profile", profile_path, class: "form-back-link d-inline-block mt-2" %>

  <div class="edit-profile-inner mx-auto pb-5">
    <h1 class="page-title mb-4">Edit your profile</h1>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, wrapper: false) do |f| %>
      <%= f.error_notification %>
  <div class="row">

    <div class="col">
      <div class="mb-4">
        <label class="form-label-start">First name</label>
        <%= f.text_field :first_name, class: "form-control" %>
      </div>
    </div>

    <div class="col">
      <div class="mb-4">
        <label class="form-label-start">Last name</label>
        <%= f.text_field :last_name, class: "form-control" %>
      </div>
    </div>
  </div>
      <div class="mb-4">
        <label class="form-label-start">Email</label>
        <%= f.email_field :email, class: "form-control", autofocus: true %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="edit-profile-reconfirmation text-muted mb-4">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
      <% end %>

      <p class="edit-profile-hint fst-italic mb-2">Leave blank to keep current</p>

      <div class="mb-4">
        <label class="form-label-start">New password</label>
        <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
      </div>

      <div class="mb-4">
        <label class="form-label-start">Confirm new password</label>
        <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
      </div>

      <div class="mb-4">
        <label class="form-label-start">Current password</label>
        <%= f.password_field :current_password, class: "form-control", required: true, autocomplete: "current-password" %>
      </div>

      <%= f.submit "Save changes", class: "edit-profile-submit  rounded-pill mt-4" %>
    <% end %>

    <div class="edit-profile-danger-zone mt-5 pt-4">
      <p class="edit-profile-danger-zone__note text-muted mb-2">Unhappy? You can permanently delete your account.</p>
      <%= link_to "Delete my account", registration_path(resource_name),
            class: "delete-account-link",
            data: { turbo_method: :delete, turbo_confirm: "Are you sure? This cannot be undone." } %>
    </div>
  </div>
</div>
