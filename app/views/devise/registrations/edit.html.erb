<div class="container" style="max-width: 900px;">
  <%= link_to "← Back to profile", profile_path, class: "form-back-link d-inline-block mt-2" %>

  <div class="mx-auto pb-5" style="max-width: 480px; text-align: center; padding-top: .5rem;">
    <h1 class="page-title mb-4">Edit your profile</h1>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, wrapper: false) do |f| %>
      <%= f.error_notification %>

      <div class="mb-4">
        <label style="text-align: center;">First name</label>
        <%= f.text_field :first_name, class: "form-control" %>
      </div>

      <div class="mb-4">
        <label style="text-align: center;">Last name</label>
        <%= f.text_field :last_name, class: "form-control" %>
      </div>

      <div class="mb-4">
        <label style="text-align: center;">Email</label>
        <%= f.email_field :email, class: "form-control", autofocus: true %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-muted mb-4" style="font-size: 13px;">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
      <% end %>

      <p class="fst-italic mb-2" style="font-size: 13px; font-weight: 500; color: #64748B; text-align: center;">Leave blank to keep current</p>

      <div class="mb-4">
        <label style="text-align: center;">New password</label>
        <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
      </div>

      <div class="mb-4">
        <label style="text-align: center;">Confirm new password</label>
        <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
      </div>

      <div class="mb-4">
        <label style="text-align: center;">Current password</label>
        <%= f.password_field :current_password, class: "form-control", required: true, autocomplete: "current-password" %>
      </div>

      <%= f.submit "Save changes", class: "btn btn-primary rounded-pill mt-4", style: "padding: 12px 32px;" %>
    <% end %>

    <div class="mt-5 pt-4" style="border-top: 1px solid #E2E8F0;">
      <p class="text-muted mb-2" style="font-size: 13px;">Unhappy? You can permanently delete your account.</p>
      <%= link_to "Delete my account", registration_path(resource_name),
            class: "delete-account-link",
            data: { turbo_method: :delete, turbo_confirm: "Are you sure? This cannot be undone." },
            style: "color: #FB7185; font-size: 14px; font-weight: 600; text-decoration: none;" %>
    </div>
  </div>
</div>
