<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<% end %>

<div class="medications-container container mx-auto px-4 pb-4">
  <div class="d-flex justify-content-center align-items-center flex-wrap gap-3 mt-4 mb-5">
    <h1 class="page-title mb-0">My Medications</h1>
    <%= link_to new_medication_path, class: "btn-add-medication text-decoration-none", data: { controller: "add-button", action: "mousedown->add-button#pulse" } do %>
      <span class="btn-add-medication-icon">+</span>
      Add a medication
    <% end %>
  </div>

  <% if @medications.empty? %>
    <p class="text-muted text-center">No medications yet.</p>
  <% else %>
    <% upcoming = @medications.reject(&:taken_today?) %>
    <% taken_today = @medications.select(&:taken_today?) %>

    <div data-controller="medication-modal">
      <section class="mb-4">
        <div class="medications-section-header mb-3">
          <h2 class="medications-section-title mb-0">⏰ Upcoming</h2>
        </div>
        <% if upcoming.empty? %>
          <div class="medications-section-header">
            <p class="text-muted mb-0">Nothing left to take today.</p>
          </div>
        <% else %>
          <div class="vertical-scroll-wrapper align-items-center">
            <% upcoming.each do |medication| %>
              <%= render "medication_card", medication: medication %>
            <% end %>
          </div>
        <% end %>
      </section>

      <hr class="medications-divider">

      <section class="mt-4">
        <div class="medications-section-header mb-3">
          <h2 class="medications-section-title mb-0">✓ Taken today </h2>
        </div>
        <% if taken_today.empty? %>
          <div class="medications-section-header">
            <p class="text-muted mb-0">No medications taken yet today.</p>
          </div>
        <% else %>
          <div class="vertical-scroll-wrapper align-items-center">
            <% taken_today.each do |medication| %>
              <%= render "medication_card", medication: medication %>
            <% end %>
          </div>
        <% end %>
      </section>

      <%= render "medications/medication_modal", medications: @medications %>
    </div>
  <% end %>
</div>
