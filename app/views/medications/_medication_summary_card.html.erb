<div class="col-12 col-md-4 h-100">
  <div class="medication-card-wrapper mx-auto">

    <div class="medication-card-body"
         data-action="click->medication-modal#open"
         data-medication-id="<%= medication.id %>">

      <div class="d-flex align-items-center gap-3 w-100">
        <span class="medication-card-icon"><%= medication_icon(medication) %></span>
        <div>
          <h3 class="medication-card-name mb-1"><%= medication.name %></h3>
          <p class="medication-card-dosage mb-0"><%= medication.dosage %></p>
        </div>
      </div>
    </div>

    <div class="medication-card-footer d-flex align-items-center justify-content-between">
      <div class="medication-card-time mb-0">
        <i class="fa-regular fa-clock"></i> <%= medication.reminder_time %>
      </div>

      <div class="medication-card-action" data-action="click->medication-modal#stop">
        <% if medication.taken_today? %>
          <span class="medication-card-taken-badge badge rounded-pill d-inline-flex align-items-center justify-content-center">
            ✓ TAKEN <%= medication.last_taken_time %>
          </span>
        <% else %>
          <%= button_to "✓ Mark as taken", medication_medication_logs_path(medication),
                method: :post,
                class: "medication-card-pill-btn btn btn-action rounded-pill text-uppercase d-inline-flex align-items-center justify-content-center",
                data: { controller: "taken-button", action: "click->taken-button#flash click->medication-modal#stop" } %>
        <% end %>
      </div>
    </div>

  </div>
</div>
