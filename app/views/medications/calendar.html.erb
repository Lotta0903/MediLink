<div class="container mt-4" data-controller="calendar">

  <div class="row align-items-center mt-4 mb-3">
    <div class="col text-center">
      <%= link_to "← Back", medications_path, class: "form-back-link" %>
    </div>
    <div class="col">
      <h1 class="page-title mb-0"> Calendar </h1>
    </div>
    <div class="col"> </div>
  </div>

  <% if @user %>
    <h2 class="mb-3"> Your agenda </h2>
  <% end %>

  <div class="calendar-container border border-primary mx-auto">
    <header class="calendar-header">
      <div class="calendar-navigation">
        <span id="calendar-prev" class="material-symbols-rounded">
          <
        </span>
      </div>
      <p class="calendar-current-date"></p>
      <div class="calendar-navigation">
        <span id="calendar-next" class="material-symbols-rounded">
          >
        </span>
      </div>
    </header>
    <div class="calendar-body">
      <ul class="calendar-weekdays">
        <li>Sun</li>
        <li>Mon</li>
        <li>Tue</li>
        <li>Wed</li>
        <li>Thu</li>
        <li>Fri</li>
        <li>Sat</li>
      </ul>
      <ul class="calendar-dates"></ul>
    </div>
  </div>

  <div id="med-day-info" class="card border border-primary rounded-4 mx-auto mt-4"
  data-action="click->calendar#enableInfo" data-calendar-target="medlist">
    <div class="card-body">

      <h3 class="mb-3"> <%= Date.today.strftime("%B") %> <%= Date.today.day %>, <%= Date.today.year %> </h3>

      <% medications = @medications.sort_by { |medication| medication.reminder_time } %>
      <% medications.each do |medication| %>
        <p class="border border-primary border-top-0 border-start-0 rounded-4 p-1 mb-3">
        <b> <%= medication.name.capitalize %> (<%= medication.dosage %>) </b>
        <br> Reminder Time: <%= medication.reminder_time %> / <%= medication.frequency %> </p>
      <% end %>

    </div>
  </div>

  <h2 class="mt-5 mb-4"> View your follows' agendas </h2>

  <% if @following.empty? %>
    <p class="text-muted text-center mb-5"> You're not following anyone </p>
  <% else %>
    <div class="row g-4 justify-content-center mb-5">
      <% @following.each do |followed_user| %>
        <%= render "followed_user_agenda", followed_user: followed_user %>
      <% end %>
    </div>
  <% end %>

</div>
