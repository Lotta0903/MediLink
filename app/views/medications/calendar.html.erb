<div class="container mt-4" data-controller="calendar medication-modal"
     data-calendar-my-medications-value="<%= @medications_by_date.to_json %>"
     data-calendar-followed-value="<%= @following_medications_by_user.to_json %>">

  <div class="calendar-switcher mt-4 mb-4">
    <label for="calendar-viewer-select" class="calendar-switcher__label">Viewing calendar of:</label>
    <select id="calendar-viewer-select"
            class="calendar-switcher__select"
            data-action="change->calendar#switchViewer">
      <option value="me">Me</option>
      <% @following.each do |followed_user| %>
        <option value="<%= followed_user.id %>"><%= followed_user.full_name %></option>
      <% end %>
    </select>
  </div>

  <div class="calendar-container border border-primary mx-auto">
    <header class="calendar-header">
      <div class="calendar-navigation">
        <span id="calendar-prev" data-action="click->calendar#prevMonth">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 6 9 12 15 18"></polyline>
          </svg>
        </span>
      </div>
      <p class="calendar-current-date" data-calendar-target="currentDate"></p>
      <div class="calendar-navigation">
        <span id="calendar-next" data-action="click->calendar#nextMonth">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 6 15 12 9 18"></polyline>
          </svg>
        </span>
      </div>
    </header>
    <div class="calendar-body">
      <ul class="calendar-weekdays">
        <li>Sun</li>
        <li>Mon</li>
        <li>Tue</li>
        <li>Wed</li>
        <li>Thu</li>
        <li>Fri</li>
        <li>Sat</li>
      </ul>
      <ul class="calendar-dates" data-calendar-target="dates"></ul>
    </div>
  </div>

  <div id="med-day-info" class="card border border-primary rounded-4 mx-auto mt-4">
    <div class="card-body">
      <h3 class="mb-3" data-calendar-target="dayInfoHeading"></h3>
      <div data-calendar-target="dayInfoList"></div>
    </div>
  </div>

  <%= render "medications/medication_modal", medications: @modal_medications %>
</div>
