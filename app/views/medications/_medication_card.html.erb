<div class="medication-card-vertical mx-auto position-relative"
     data-action="click->medication-modal#open"
     data-medication-id="<%= medication.id %>">

  <div class="medication-card-actions-vertical position-absolute d-flex">
    <%= link_to edit_medication_path(medication), data: { action: "click->medication-modal#stop" } do %>
      <i class="bi bi-pencil icon-muted medication-action-icon"></i>
    <% end %>

    <%= button_to medication_path(medication),
          method: :delete,
          class: "btn btn-link p-0 border-0 medication-delete-button",
          form: { data: { turbo_confirm: "Are you sure you want to delete this medication?" } },
          data: { action: "click->medication-modal#stop" } do %>
      <i class="bi bi-trash icon-muted medication-action-icon"></i>
    <% end %>
  </div>

  <div class="medication-card-content-vertical flex-grow-1">
    <div class="medication-name-wrapper d-flex align-items-center">
      <span class="medication-pill-icon"><%= medication_icon(medication) %></span>
      <p class="medication-name mb-0"><%= medication.name %></p>
    </div>

    <p class="medication-dosage mb-0"><%= medication.dosage %></p>

    <div class="medication-info-row">
      <span class="medication-time-inline">
        <i class="bi bi-clock"></i> <%= medication.reminder_time %>
      </span>
      <span class="medication-frequency"><%= medication.frequency %></span>

      <% if medication.taken_today? %>
        <span class="medication-taken-badge badge rounded-pill d-inline-flex align-items-center justify-content-center">
          ✓ TAKEN <%= medication.last_taken_time %>
        </span>
      <% else %>
        <%= button_to "✓ Mark as taken",
              medication_medication_logs_path(medication),
              method: :post,
              class: "btn btn-mark-taken btn-action rounded-pill text-uppercase d-inline-flex align-items-center justify-content-center medication-action-button",
              data: { controller: "taken-button", action: "click->taken-button#flash click->medication-modal#stop" } %>
      <% end %>
    </div>
  </div>

  <div class="medication-card-footer-actions">
    <%= button_to medication_chats_path(medication),
          method: :post,
          class: "btn btn-medibot-pill rounded-pill text-uppercase d-inline-flex align-items-center justify-content-center medication-action-button",
          data: { action: "click->medication-modal#stop" } do %>
      💬 Ask MediBot
    <% end %>
  </div>

</div>
