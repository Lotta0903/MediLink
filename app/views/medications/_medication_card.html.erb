<div class="medication-card-vertical mx-auto position-relative">

  <div class="medication-card-actions-vertical position-absolute d-flex">
    <%= link_to edit_medication_path(medication) do %>
      <i class="bi bi-pencil icon-muted medication-action-icon"></i>
    <% end %>

    <%= button_to medication_path(medication),
          method: :delete,
          class: "btn btn-link p-0 border-0 medication-delete-button",
          form: { data: { turbo_confirm: "Are you sure you want to delete this medication?" } } do %>
      <i class="bi bi-trash icon-muted medication-action-icon"></i>
    <% end %>
  </div>

  <div class="medication-card-content-vertical d-flex flex-grow-1">
    <p class="medication-time-vertical text-primary mb-0"><%= medication.reminder_time %></p>

    <div class="medication-details d-flex flex-column">
      <div class="medication-name-wrapper d-flex align-items-center justify-content-center">
        <span class="medication-pill-icon">💊</span>
        <p class="medication-name mb-0"><%= medication.name %></p>
      </div>

      <p class="medication-dosage mb-0"><%= medication.dosage %></p>
      <p class="medication-frequency text-muted mb-0"><%= medication.frequency %></p>
    </div>
  </div>

  <div class="medication-card-footer mt-auto text-center pt-2">
    <div class="medication-footer-actions d-flex flex-nowrap justify-content-center align-items-center">

      <% if medication.taken_today? %>
        <span class="medication-taken-badge badge rounded-pill d-inline-flex align-items-center justify-content-center">
          ✓ TAKEN <%= medication.last_taken_time %>
        </span>
      <% else %>
        <%= button_to "✓ Mark as taken",
              medication_medication_logs_path(medication),
              method: :post,
              class: "btn btn-mark-taken btn-action rounded-pill text-uppercase d-inline-flex align-items-center justify-content-center medication-action-button",
              data: { controller: "taken-button", action: "click->taken-button#flash" } %>
      <% end %>

      <%= button_to medication_chats_path(medication),
            method: :post,
            class: "btn btn-medibot-pill rounded-pill text-uppercase d-inline-flex align-items-center justify-content-center medication-action-button" do %>
        💬 Ask MediBot
      <% end %>

    </div>
  </div>

</div>
