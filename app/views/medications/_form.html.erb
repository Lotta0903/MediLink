<%
  medication_names = [
    "Amlodipine", "Amoxicillin", "Aspirin", "Atorvastatin", "Calcium", "Cetirizine",
    "Clopidogrel", "Codeine", "Cranberry supplement", "Dafalgan", "Diazepam",
    "Diclofenac", "Doliprane", "Efferalgan", "Fluoxetine", "Folic acid", "Furosemide",
    "Gaviscon", "Ibuprofen", "Imodium", "Insulin", "Iron supplement", "Levothyroxine",
    "Lexomil", "Lisinopril", "Loratadine", "Magnesium", "Melatonin", "Metformin",
    "Morphine", "Multivitamin", "Naproxen", "Nurofen", "Omega-3", "Omeprazole",
    "Paracetamol", "Prednisone", "Probiotic", "Ramipril", "Salbutamol", "Sertraline",
    "Simvastatin", "Smecta", "Spasfon", "Stilnox", "Tramadol", "Ventolin",
    "Vitamin B12", "Vitamin C", "Vitamin D", "Voltaren", "Warfarin", "Xanax", "Zinc",
    "Zolpidem"
  ].sort

  current_hour, current_minute = medication.reminder_time.to_s.split(":")

  name_in_presets = medication_names.include?(medication.name)
  selected_days = medication.frequency.to_s.split(",").map(&:strip)

  section_label_style = "font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #64748B; margin-top: 24px; margin-bottom: 12px;"
%>

<div class="medication-form-container container">
  <%= link_to "← Back", medications_path, class: "form-back-link d-inline-block mt-2" %>

  <div class="medication-form-inner mx-auto pb-5">
    <h1 class="page-title mb-4"><%= medication.persisted? ? "Edit medication" : "Add a medication" %></h1>

    <%= simple_form_for medication, wrapper: false do |f| %>
      <%= f.error_notification %>

      <p class="text-center" style="<%= section_label_style %> margin-top: 0;">What</p>

      <div class="mb-4" data-controller="custom-medication">
        <label>Medication name</label>
        <select data-custom-medication-target="select"
                data-action="change->custom-medication#update"
                class="form-select">
          <%= options_for_select([["Choose a medication...", ""]] + medication_names.map { |n| [n, n] }, name_in_presets ? medication.name : "") %>
        </select>

        <p class="medication-form-hint mt-3 mb-2">If other, type medication name here</p>
        <input type="text"
               data-custom-medication-target="customInput"
               data-action="input->custom-medication#update"
               class="form-control"
               value="<%= name_in_presets ? "" : medication.name %>"
               placeholder="Medication name...">

        <%= f.hidden_field :name, data: { custom_medication_target: "hiddenName" } %>
      </div>

      <div class="mb-4">
        <label>Dosage</label>
        <%= f.text_field :dosage, class: "form-control", placeholder: "e.g. 500mg" %>
      </div>

      <p class="text-center" style="<%= section_label_style %>">How</p>

      <div class="mb-4" data-controller="frequency-days">
        <label class="form-label-centered mb-3">Frequency</label>
        <div class="form-days-row d-flex flex-wrap justify-content-center">
          <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day| %>
            <input type="checkbox"
                   id="frequency_day_<%= day.downcase %>"
                   class="day-checkbox"
                   value="<%= day %>"
                   data-frequency-days-target="checkbox"
                   data-action="change->frequency-days#update"
                   <%= "checked" if selected_days.include?(day) %>>
            <label for="frequency_day_<%= day.downcase %>" class="day-pill"><%= day %></label>
          <% end %>
        </div>
        <p class="form-days-helper text-muted mt-2 mb-0 fst-italic">Select the days you take this medication</p>

        <%= f.hidden_field :frequency, data: { frequency_days_target: "hiddenName" } %>
      </div>

      <div class="mb-4">
        <label class="form-label-centered mb-2">How often?</label>
        <%= f.text_field :dose_frequency, class: "form-control", placeholder: "e.g. once a day, every 8 hours" %>
      </div>

      <div class="mb-4">
        <label>How to take</label>
        <%= f.select :intake_instructions,
              ["Any time", "Before meals", "After meals", "On empty stomach", "Before bed", "With food"],
              { include_blank: false }, class: "form-select" %>
      </div>

      <div class="mb-4">
        <label>With food</label>
        <%= f.select :with_food, ["No", "Yes", "Optional"], { include_blank: false }, class: "form-select" %>
      </div>

      <p class="text-center" style="<%= section_label_style %>">When</p>

      <div class="mb-4" data-controller="time-picker">
        <label>Reminder time</label>
        <div class="time-picker-row d-flex align-items-center">
          <select data-time-picker-target="hours"
                  data-action="change->time-picker#update"
                  class="time-picker-select form-select">
            <%= options_for_select((0..23).map { |h| format("%02d", h) }, current_hour) %>
          </select>
          <span class="time-picker-separator">:</span>
          <select data-time-picker-target="minutes"
                  data-action="change->time-picker#update"
                  class="time-picker-select form-select">
            <%= options_for_select((0..59).map { |m| format("%02d", m) }, current_minute) %>
          </select>
        </div>

        <%= f.hidden_field :reminder_time, data: { time_picker_target: "hiddenName" } %>
      </div>

      <div class="dates-row mb-4 d-flex justify-content-center">
        <div class="flex-fill">
          <label class="form-label-centered">Start date</label>
          <%= f.date_field :start_date, class: "form-control date-field-centered" %>
        </div>
        <div class="flex-fill">
          <label class="form-label-centered">End date</label>
          <%= f.date_field :end_date, class: "form-control date-field-centered" %>
        </div>
      </div>

      <p class="text-center" style="<%= section_label_style %>">Notes</p>

      <div class="mb-4">
        <label>Notes (optional)</label>
        <%= f.text_area :notes, rows: 3, class: "form-control", placeholder: "Instructions from your doctor, side effects to watch, any reminders..." %>
      </div>

      <%= button_tag type: "submit", class: "btn-add-medication text-decoration-none mt-4", data: { controller: "add-button", action: "mousedown->add-button#pulse" } do %>
        <span class="btn-add-medication-icon">+</span>
        Add medication
      <% end %>
    <% end %>
  </div>
</div>
