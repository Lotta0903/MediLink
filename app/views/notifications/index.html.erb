<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<% end %>

<div class="notifications-container container mx-auto px-4 pb-5">
  <div class="text-center mb-5 position-relative">
    <h1 class="page-title mt-4 mb-2">Notifications 🔔</h1>
    <% if @has_unread %>
      <%= link_to "Mark all as read", notifications_path, class: "btn btn-outline-primary btn-sm position-absolute top-0 end-0" %>
    <% end %>
  </div>

  <% if @notifications.empty? %>
    <div class="notifications-empty text-center">
      <p class="notifications-empty__icon mb-2">🔔</p>
      <p class="notifications-empty__title mb-1">No notifications yet</p>
      <p class="notifications-empty__subtitle text-muted mb-0">You'll see updates here when your circle takes their medications.</p>
    </div>
  <% else %>
    <% @notifications_by_day.each do |date, day_notifications| %>
      <% label = if date == Date.current
                   "Today"
                 elsif date == Date.current - 1.day
                   "Yesterday"
                 else
                   date.strftime("%B %-d")
                 end %>
      <h2 class="notifications-day-title mb-3"><%= label %></h2>

      <% day_notifications.each do |notification| %>
        <div class="notification-card d-flex align-items-center gap-3 mb-3">
          <%= render "shared/user_avatar", user: notification.medication.user, size: 48 %>

          <div class="flex-grow-1">
            <p class="notification-card__message mb-0"><%= notification.message %></p>
            <p class="notification-card__meta text-muted mb-0">
              <%= notification.status == :taken ? "Taken at" : "Missed at" %> <%= notification.medication.reminder_time %>
            </p>
          </div>

          <% if notification.status == :taken %>
            <span class="notification-card__badge badge badge-success-soft rounded-pill">✓ Viewed</span>
          <% else %>
            <span class="notification-card__badge badge badge-danger-soft rounded-pill">Missed</span>
          <% end %>

          <%= button_to notification_path(notification), method: :delete, class: "btn btn-link p-0 border-0", form: { data: { turbo_confirm: "Delete this notification?" } } do %>
            <i class="notification-card__delete-icon bi bi-trash icon-muted"></i>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
