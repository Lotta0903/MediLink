<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "MediLink — Never miss a dose, stay connected" %></title>

    <%= favicon_link_tag  %>

    <meta name="description" content="MediLink helps families track medications together. Never miss a dose, stay connected with the people who care about you.">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Medilink">
    <meta name="mobile-web-app-capable" content="yes">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.medilinkapp.com">
    <meta property="og:title" content="MediLink — Never miss a dose, stay connected">
    <meta property="og:description" content="MediLink helps families track medications together. Never miss a dose, stay connected with the people who care about you.">
    <meta property="og:image" content="https://www.medilinkapp.com/og-image.png">
    <meta property="og:site_name" content="MediLink">
    <meta property="og:locale" content="en_US">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://www.medilinkapp.com">
    <meta name="twitter:title" content="MediLink — Never miss a dose, stay connected">
    <meta name="twitter:description" content="MediLink helps families track medications together. Never miss a dose, stay connected with the people who care about you.">
    <meta name="twitter:image" content="https://www.medilinkapp.com/og-image.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%= yield :head %>

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/navbar" %>
    <%= render "shared/flashes" %>

    <%= yield %>

    <% if user_signed_in? %>
      <div class="notification-toast-container" data-controller="notification-toast"></div>
    <% end %>

  </body>
</html>
