<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<% end %>

<div>
  <div class="container mt-4">
    <h1 class="page-title mb-2">My Profile</h1>
  </div>

  <div class="container d-flex justify-content-center">
    <div class="profile-card app-card text-center">
      <div class="mb-3">
        <%= render "shared/user_avatar", user: @user, size: 128 %>
      </div>

      <h2 class="mb-3"><%= @user.full_name %></h2>
      <p class="text-muted small mb-4"><%= @user.email %></p>

      <%= link_to "Edit profile", edit_user_registration_path, class: "btn btn-primary btn-action" %>
    </div>
  </div>
</div>
